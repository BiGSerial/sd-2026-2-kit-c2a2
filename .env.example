# Copie para .env (cp .env.example .env). O docker compose le este arquivo.
# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline). Nunca commite a chave.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# Protecao do LLM (valores padrao; descomente para ajustar)
# LLM_TIMEOUT=10
# LLM_TENTATIVAS=3
# LLM_BACKOFF=0.5
# LLM_LIMITE_FALHAS=3
# LLM_ESPERA_CIRCUITO=20

# --- Apenas para rodar SEM docker (cada servico em um terminal) ---
# URL_INGESTAO=http://localhost:8001
# URL_RECUPERACAO=http://localhost:8002
# REDIS_URL=redis://localhost:6379/0
# DATA_DIR=dados
